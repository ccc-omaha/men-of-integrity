<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ settings.seoTitle }}</title>
<meta name="description" content="{{ settings.seoDescription }}">
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href="{{ site.url }}/">
<meta name="theme-color" content="#0A0D1C">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta property="og:site_name" content="Men of Integrity">
<meta property="og:locale" content="en_US">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}/">
<meta property="og:title" content="{{ settings.shareTitle }}">
<meta property="og:description" content="{{ settings.shareDescription }}">
{% if settings.shareImage %}<meta property="og:image" content="{{ shareImageAbs }}">
<meta property="og:image:alt" content="{{ settings.shareTitle }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ shareImageAbs }}">{% endif %}
<meta name="twitter:title" content="{{ settings.shareTitle }}">
<meta name="twitter:description" content="{{ settings.shareDescription }}">
<link rel="preconnect" href="https://use.typekit.net" crossorigin>
<link rel="preconnect" href="https://p.typekit.net" crossorigin>
<link rel="stylesheet" href="https://use.typekit.net/ohw6ayv.css">
<style>
{{ "styles.css" | file }}
</style>
<script type="application/ld+json">{{ schema | jsonscript }}</script>
</head>
<body>

<header id="top">
  <div class="wrap nav">
    <a href="#top" class="logo" aria-label="Men of Integrity home">
      <span class="logo-mark">MI</span>
      <span class="logo-text">Men of Integrity</span>
    </a>
    <button class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <ul class="nav-links" id="nav-links">
      <li><a href="#about">About</a></li>
      {% if story.show %}<li><a href="#story">{{ story.title }}</a></li>{% endif %}
      <li><a href="#start">First Steps</a></li>
      <li><a href="#visit">Visit</a></li>
      <li><a href="#resources">Resources</a></li>
      <li><a href="{{ smsHref }}" class="btn btn-primary">Text {{ firstName }}</a></li>
    </ul>
  </div>
</header>

<main>

<!-- HERO -->
<section class="hero">
  <div class="topo" aria-hidden="true"></div>
  {{ "ridge-hero.svg" | file }}
  <div class="wrap">
    <div class="eyebrow">{{ top.eyebrow }}</div>
    <h1>{{ top.headline }} <em>{{ top.headlineAccent }}</em></h1>
    <p>{{ top.intro | md }}</p>
    <div class="hero-cta">
      <a href="#visit" class="btn btn-primary">{{ top.primaryButton }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="{{ smsHref }}" class="btn btn-ghost">{{ top.secondaryButton }}</a>
    </div>
    <div class="hero-meta">
      <div><strong>{{ meeting.day }}</strong>{{ meeting.time }}</div>
      <div><strong>{{ meeting.venue }}</strong>{{ addressShort }}</div>
      <div><strong>Open Group</strong>{{ top.openGroupText }}</div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about" class="about">
  <div class="wrap about-grid">
    <div class="reveal">
      <div class="eyebrow">{{ about.eyebrow }}</div>
      <h2>{{ about.heading }}</h2>
      <p class="lead">{{ about.lead | md }}</p>
      <p>{{ about.body | md }}</p>
      <div class="open-tag"><span class="dot"></span>{{ about.openNote }}</div>
    </div>
    {% if about.verse %}
    <aside class="quote-card reveal">
      <div class="q">{{ about.verse }}</div>
      <div class="ref">{{ about.verseRef }}</div>
    </aside>
    {% endif %}
  </div>
</section>

<!-- PILLARS -->
<section class="pillars">
  <div class="wrap">
    <div class="reveal">
      <div class="eyebrow">{{ pillars.eyebrow }}</div>
      <h2>{{ pillars.heading }}</h2>
      <p class="lead">{{ pillars.intro | md }}</p>
    </div>
    <div class="pillar-grid reveal">
      {% for p in pillars.items %}
      <div class="pillar"><div class="pillar-top"><span class="pillar-ic">{{ (p.icon or "compass") | icon(30) }}</span><span class="num">{{ loop.index | pad }}</span></div><h3>{{ p.title }}</h3><p>{{ p.text | md }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

{% if story.show %}
<!-- STORY VIDEO -->
<section id="story" class="story">
  <div class="wrap">
    <div class="reveal story-head">
      <div class="eyebrow">{{ story.eyebrow }}</div>
      <h2>{{ story.heading }}</h2>
      <p class="lead">{{ story.intro | md }}</p>
    </div>
    <div class="player reveal" id="player" data-state="idle" data-hls="{{ story.hlsUrl }}" data-vimeo="{{ story.vimeoId }}" data-title="{{ story.title }} | Men of Integrity"{% if story.poster %} style="--poster:url('{{ story.poster }}')"{% endif %}>
      <video id="vid" playsinline preload="none"{% if story.poster %} poster="{{ story.poster }}"{% endif %} aria-label="{{ story.title }}"></video>

      <button class="cover" id="cover" aria-label="Play {{ story.title }}">
        <span class="cover-play"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
        <span class="cover-text">
          <span class="cover-eyebrow">{{ story.coverLabel }}</span>
          <span class="cover-title">{{ story.title }}</span>
        </span>
      </button>

      <div class="spinner" aria-hidden="true"></div>

      <div class="controls" id="controls">
        <button class="ctl" id="btn-play" aria-label="Play">
          <svg class="i-play" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
          <svg class="i-pause" viewBox="0 0 24 24"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"/></svg>
        </button>
        <span class="time" id="t-cur">0:00</span>
        <div class="scrub" id="scrub" role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="scrub-buf" id="scrub-buf"></div>
          <div class="scrub-fill" id="scrub-fill"><span class="scrub-knob"></span></div>
        </div>
        <span class="time" id="t-dur">0:00</span>
        <button class="ctl" id="btn-mute" aria-label="Mute">
          <svg class="i-vol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>
          <svg class="i-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor"/><path d="m16 9 6 6M22 9l-6 6"/></svg>
        </button>
        <button class="ctl" id="btn-fs" aria-label="Fullscreen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>
{% endif %}

<!-- FIRST STEPS -->
<section id="start">
  <div class="wrap">
    <div class="reveal">
      <div class="eyebrow">{{ steps.eyebrow }}</div>
      <h2>{{ steps.heading }}</h2>
      <p class="lead">{{ steps.intro | md }}</p>
    </div>
    <div class="steps">
      {% for s in steps.items %}
      <div class="step reveal">
        <div class="step-n">{{ loop.index }}</div>
        <h3>{{ s.title }}</h3>
        <p>{{ s.text | md }}</p>
        {% if s.linkText and s.linkUrl %}<a class="link" href="{{ s.linkUrl }}"{% if s.linkUrl.startsWith('http') %} target="_blank" rel="noopener"{% endif %}>{{ s.linkText }} &rarr;</a>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% if steps.reassureText %}
    <div class="reassure reveal">
      <p>{% if steps.reassureTitle %}<strong>{{ steps.reassureTitle }}</strong> {% endif %}{{ steps.reassureText | md }}</p>
    </div>
    {% endif %}
  </div>
</section>

<!-- VISIT -->
<section id="visit" class="visit">
  <div class="topo" aria-hidden="true"></div>
  <div class="wrap">
    <div class="reveal">
      <div class="eyebrow">{{ meeting.eyebrow }}</div>
      <h2>{{ meeting.heading }}</h2>
    </div>
    {% if meeting.showBuilding %}
    <figure class="building-fig reveal">
      {{ "student-center.svg" | file }}
      {% if meeting.buildingCaption %}<figcaption>{{ "pin" | icon(16) }}{{ meeting.buildingCaption }}</figcaption>{% endif %}
    </figure>
    {% endif %}
    <div class="visit-grid">
      <div class="visit-card reveal">
        <div class="row">
          <div class="label">{{ "calendar" | icon(16) }}When</div>
          <div class="big">{{ meeting.day }}</div>
          <p>{{ meeting.time }}{% if meeting.timeNote %}, {{ meeting.timeNote }}{% endif %}</p>
        </div>
        <div class="row">
          <div class="label">{{ "pin" | icon(16) }}Where</div>
          <div class="big">{{ meeting.venue }}</div>
          <p>{{ meeting.address | md }}</p>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href="{{ meeting.directionsUrl }}" target="_blank" rel="noopener">Get Directions</a>
        </div>
      </div>
      <div class="visit-card reveal">
        <div class="label">{{ "message" | icon(16) }}{{ meeting.contactLabel }}</div>
        <div class="contact-person">
          <div class="avatar">{{ meeting.contactName | first }}</div>
          <div><strong>{{ meeting.contactName }}</strong><span>{{ meeting.contactRole }}</span></div>
        </div>
        <p>{{ meeting.contactText | md }}</p>
        <div class="contact-lines" style="margin-top:22px">
          <a href="{{ smsHref }}">{{ meeting.phone }}</a>
          {% if meeting.email %}<a href="mailto:{{ meeting.email }}">{{ meeting.email }}</a>{% endif %}
        </div>
        <div class="actions">
          <a class="btn btn-primary" href="{{ smsHref }}">Send a Text</a>
          {% if meeting.email %}<a class="btn btn-ghost" href="mailto:{{ meeting.email }}">Email</a>{% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- RESOURCES -->
<section id="resources">
  <div class="wrap">
    <div class="res-head reveal">
      <div>
        <div class="eyebrow">{{ resources.eyebrow }}</div>
        <h2>{{ resources.heading }}</h2>
        <p class="lead">{{ resources.intro | md }}</p>
      </div>
    </div>

    <div class="tabs" role="tablist" aria-label="Resource categories">
      {% for c in resources.categories %}
      <button class="tab" role="tab" aria-selected="{{ 'true' if loop.first else 'false' }}" aria-controls="p-{{ c.name | slug }}" id="t-{{ c.name | slug }}">{{ c.name }}</button>
      {% endfor %}
    </div>

    {% for c in resources.categories %}
    <div class="panel{% if loop.first %} active{% endif %}" id="p-{{ c.name | slug }}" role="tabpanel" aria-labelledby="t-{{ c.name | slug }}">
      {% if c.intro %}<p class="panel-intro">{{ c.intro | md }}</p>{% endif %}
      <div class="res-grid">
        {% for r in c.items %}
        <a class="res" href="{{ r.url }}" target="_blank" rel="noopener"><div>{% if r.type %}<div class="type">{{ r.type | typeicon(14) }}{{ r.type }}</div>{% endif %}<h4>{{ r.title }}</h4>{% if r.by %}<div class="by">{{ r.by }}</div>{% endif %}</div><div class="go">{{ r.action or "View" }} &rarr;</div></a>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

{% if partners.show %}
<!-- PARTNERS -->
<section class="partner">
  <div class="wrap">
    <div class="partner-box reveal">
      <div>
        <div class="eyebrow">{{ partners.eyebrow }}</div>
        <h2>{{ partners.heading }}</h2>
        <p style="color:var(--text-dim)">{{ partners.text | md }}</p>
      </div>
      <div class="partner-list">
        {% for b in partners.books %}
        <a href="{{ b.url }}" target="_blank" rel="noopener"><div><strong>{{ b.title }}</strong><span>{{ b.author }}</span></div><span class="arrow">View &rarr;</span></a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{% if faq.show and faq.items.length %}
<!-- FAQ -->
<section id="faq" class="faq">
  <div class="wrap faq-grid">
    <div class="reveal">
      <div class="eyebrow">{{ faq.eyebrow }}</div>
      <h2>{{ faq.heading }}</h2>
    </div>
    <div class="faq-list reveal">
      {% for f in faq.items %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ f.question }}<span class="plus" aria-hidden="true"></span></summary>
        <div class="answer"><p>{{ f.answer | md }}</p></div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- CLOSING -->
<section class="closing">
  <div class="topo" aria-hidden="true"></div>
  {{ "ridge-closing.svg" | file }}
  <div class="wrap">
    <div class="eyebrow">{{ closing.eyebrow }}</div>
    <h2>{{ closing.heading }}</h2>
    <p>{{ closing.text | md }}</p>
    <div class="hero-cta">
      <a href="#visit" class="btn btn-primary">{{ closing.primaryButton }}</a>
      <a href="{{ smsHref }}" class="btn btn-ghost">{{ closing.secondaryButton }}</a>
    </div>
  </div>
</section>

</main>

<footer>
  <div class="wrap foot">
    <div>&copy; <span id="yr">{{ year }}</span> Men of Integrity &middot; A Renewal ministry of <a href="https://cccomaha.org" target="_blank" rel="noopener">Christ Community Church</a></div>
    <a href="#top">Back to top &uarr;</a>
  </div>
</footer>

<script>
{{ "site.js" | file }}
</script>
</body>
</html>
